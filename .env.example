# Общие настройки
TELEGRAM_TOKEN=
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=
SAVE_DIRECTORY=

# Файл WHITELIST
WHITELIST_FILE=whitelist.txt

# Фильтр резульатов поиска 
MAX_RESULTS=5
MIN_FILE_SIZE_GB=1.3
MAX_FILE_SIZE_GB=5

# Настройка логов
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL) INFO - штатный режим.
LOG_LEVEL=DEBUG
LOG_FILE=bot.log
USE_CONSOLE=true
LOG_FORMAT='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
# Логирование неавторизованных пользователей
UNAUTHORIZED_LOG_FILE=unauthorized_users.log
ENABLE_UNAUTHORIZED_LOGGING=true

# PROXY (true/false)
USE_PROXY=false
HTTP_PROXY=http:123.4.5.6:789
HTTPS_PROXY=http:123.4.5.6:789

# Слова-исключения для base.csv
FORBIDDEN_WORDS=комедия,боевик,фантастика,фентэзи,драма,мелодрама,ситком

# База фильмов
BASE_FILE=base.csv